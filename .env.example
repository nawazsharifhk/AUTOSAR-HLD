# AutoHLD-AI Environment Configuration

# Azure OpenAI (Optional - System automatically runs high-precision local fallback engine if keys are not provided)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Standard OpenAI (Optional fallback)
OPENAI_API_KEY=

# Local Storage Paths
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_URL=sqlite:///./data/autohld.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
